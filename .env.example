# BordoMavi AI Editör — Environment Variables Example
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi doldurun
# .env dosyasını ASLA Git'e commit etmeyin!

# ============================================================
# VERİTABANI (PostgreSQL / Neon.tech)
# ============================================================
DATABASE_URL="postgresql://username:password@ep-your-db-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://username:password@ep-your-db.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# UYGULAMA & GÜVENLİK
# ============================================================
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"
NEXTAUTH_URL="https://your-site.netlify.app"
AUTH_SECRET="rastgele-guclu-bir-string-olusturun-openssl-rand-base64-32"
NEXTAUTH_SECRET="rastgele-guclu-bir-string-olusturun-openssl-rand-base64-32"

# ============================================================
# YAPAY ZEKA (AI)
# ============================================================
NVIDIA_API_KEY="nvapi-..."
OPENROUTER_API_KEY="sk-or-..."

# ============================================================
# META FACEBOOK GRAPH API
# ============================================================
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_PAGE_ID="your_facebook_page_id"
FACEBOOK_PAGE_ACCESS_TOKEN="EAAT..."
FACEBOOK_MOCK_MODE="false"

# ============================================================
# CRON GÜVENLİK
# ============================================================
CRON_SECRET="guclu-rastgele-bir-secret-girin"
