# BordoMavi AI Editör — Environment Variables
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun
# .env dosyasını ASLA Git'e commit etmeyin!

# ============================================================
# VERİTABANI (Neon.tech)
# ============================================================
# Pooler URL (uygulama için — connection pooling aktif)
DATABASE_URL="postgresql://neondb_owner:SIFRE@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct URL (Prisma migrate için — pooler olmadan)
DIRECT_URL="postgresql://neondb_owner:SIFRE@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# UYGULAMA
# ============================================================
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"
NEXTAUTH_URL="https://your-site.netlify.app"
NEXTAUTH_SECRET="rastgele-guclu-bir-string-olusturun"

# ============================================================
# YAPAY ZEKA
# ============================================================
GEMINI_API_KEY="AIza..."
AI_MODEL="gemini-3.1-flash-lite"
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# ============================================================
# FACEBOOK
# ============================================================
FACEBOOK_APP_ID="1407315788032025"
FACEBOOK_PAGE_ID="1415192102080896"
FACEBOOK_PAGE_ACCESS_TOKEN="EAAT..."
FACEBOOK_MOCK_MODE="false"

# ============================================================
# CRON GÜVENLİK
# ============================================================
CRON_SECRET="guclu-rastgele-bir-secret-girin"